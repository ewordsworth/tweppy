# ---- Cloudflare D1 (database) ----
# Dashboard sidebar or any zone overview page
CF_ACCOUNT_ID=
# Storage & Databases > D1 > your database > Database ID
CF_D1_DATABASE_ID=
# My Profile > API Tokens > Create Token, permission: Account / D1 / Edit
CF_API_TOKEN=

# ---- X (Twitter) OAuth 2.0 ----
# Developer Portal > your app > Keys and tokens > "OAuth 2.0 Client ID and Client Secret"
# (NOT the API Key/Secret pair, NOT the Bearer Token)
CLIENT_ID=

CLIENT_SECRET=
# Must exactly match the Callback URI in the app's "User authentication settings".
# authorize.py (one-time auth) listens on this address; 127.0.0.1:8080/callback by default.
REDIRECT_URI=http://127.0.0.1:8080/callback

# ---- Dashboard protection (optional but recommended on a public host) ----
# Any password you choose. Open the dashboard once with ?admin_token=<value> to set the cookie.
ADMIN_TOKEN=
# Any long random string. Keeps the session (active community) alive across restarts.
SECRET_KEY=

# ---- Local only (optional) ----
# Where the SQLite fallback lives when the CF_* vars are missing. Default: local.db
# LOCAL_DB_PATH=local.db
# PORT=5000

# ---- Open source (AGPL-3.0) ----
# The dashboard links here so users can get the source. If you run a modified copy, use your own repo URL.
# SOURCE_URL=https://github.com/ewordsworth/tweppy
